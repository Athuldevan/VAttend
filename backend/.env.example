# ─── Runtime ──────────────────────────────────────────────────────────────
# Vercel sets NODE_ENV=production automatically. Set it explicitly elsewhere.
NODE_ENV=development
# Ignored by Vercel (serverless). Used by local dev and long-running hosts.
PORT=5000

# ─── Database (REQUIRED) ──────────────────────────────────────────────────
# Local:      mongodb://localhost:27017/AMS
# Production: MongoDB Atlas SRV string. A localhost URL is rejected when
#             NODE_ENV=production.
DB_URL=mongodb://localhost:27017/AMS

# ─── JWT secrets (REQUIRED) ───────────────────────────────────────────────
# Must be different from each other, and >= 32 chars in production.
# Generate: openssl rand -base64 48
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── Passwords ────────────────────────────────────────────────────────────
# 12 is secure; lower it to 10 if serverless cold-start latency hurts.
BCRYPT_SALT_ROUNDS=12

# ─── CORS (REQUIRED in production) ────────────────────────────────────────
# Comma-separated browser origins. The Android app sends no Origin header and
# is NOT affected by this, so a mobile-only deployment can use any placeholder.
CORS_ORIGIN=http://localhost:5173

# ─── API docs ─────────────────────────────────────────────────────────────
# Public base URL of the deployed API, shown in the OpenAPI spec.
PUBLIC_API_URL=
# /docs and /api-docs.json. Defaults to false in production.
ENABLE_API_DOCS=false

# ─── Email (teacher invite codes) ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
# Gmail requires an App Password, not the account password.
SMTP_PASS=
SMTP_FROM=AMS Portal <no-reply@example.com>
